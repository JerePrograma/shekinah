{
  // Copiar a wrangler.jsonc sólo después de completar valores reales autorizados.
  // wrangler.jsonc permanece ignorado para evitar publicar configuración de cuenta accidentalmente.
  "name": "shekinah",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-21",
  // Para uploads directos de Pages, el nivel superior representa preview y
  // env.production representa production. Mantener ambos completos: Wrangler
  // puede reemplazar la configuración remota usando este archivo como autoridad.
  "vars": {
    "ALLOWED_SITE_ORIGINS": "https://mp-sandbox.shekinah-7dl.pages.dev",
    "ANALYTICS_ENABLED": "true",
    "ANALYTICS_RETENTION_DAYS": "730",
    "COMMERCE_ENABLED": "true",
    "MERCADO_PAGO_CHECKOUT_MODE": "sandbox",
    "PUBLIC_SITE_URL": "https://mp-sandbox.shekinah-7dl.pages.dev",
    "VITE_ANALYTICS_ENABLED": "true",
    "VITE_COMMERCE_ENABLED": "false"
  },
  // Cargar ADMIN_USERNAME, ADMIN_PASSWORD_HASH, ADMIN_SESSION_SECRET y
  // ADMIN_RATE_LIMIT_SECRET sólo como secretos cifrados de Pages, por entorno.
  // CLOUDFLARE_ACCESS_TEAM_DOMAIN y CLOUDFLARE_ACCESS_AUD son opcionales y
  // sólo se usan para el fallback interno de Access.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REEMPLAZAR_NOMBRE_D1_PREVIEW",
      "database_id": "REEMPLAZAR_ID_D1_PREVIEW",
      "preview_database_id": "REEMPLAZAR_ID_D1_PREVIEW"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CATALOG_IMAGES",
      "bucket_name": "REEMPLAZAR_BUCKET_R2_PREVIEW"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "ALLOWED_SITE_ORIGINS": "https://shekinah.ar",
        "ANALYTICS_ENABLED": "true",
        "ANALYTICS_RETENTION_DAYS": "730",
        "COMMERCE_ENABLED": "false",
        "MERCADO_PAGO_CHECKOUT_MODE": "production",
        "PUBLIC_SITE_URL": "https://shekinah.ar",
        "VITE_ANALYTICS_ENABLED": "true",
        "VITE_COMMERCE_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REEMPLAZAR_NOMBRE_D1_PRODUCTION",
          "database_id": "REEMPLAZAR_ID_D1_PRODUCTION"
        }
      ],
      "r2_buckets": [
        {
          "binding": "CATALOG_IMAGES",
          "bucket_name": "REEMPLAZAR_BUCKET_R2_PRODUCTION"
        }
      ]
    }
  }
}
