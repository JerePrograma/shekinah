{
  "name": "shekinah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run generate:commerce-catalog && vite --host 127.0.0.1 --port 4173",
    "build": "npm run generate:commerce-catalog && vite build",
    "build:pages": "npm run lint && npm run typecheck && npm run test && npm run verify:catalog && npm run verify:commerce-catalog && npm run build && npm run verify:assets && npm run verify:security && npm run verify:automation",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "npm run generate:commerce-catalog && eslint .",
    "typecheck": "npm run generate:commerce-catalog && tsc --noEmit",
    "test": "npm run generate:commerce-catalog && vitest run",
    "test:watch": "npm run generate:commerce-catalog && vitest",
    "test:e2e": "playwright test",
    "install:browsers": "playwright install chromium",
    "generate:commerce-catalog": "node scripts/generate-commerce-catalog.mjs",
    "verify:commerce-catalog": "node scripts/verify-commerce-catalog.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:automation": "node scripts/verify-automation.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run verify:catalog && npm run verify:commerce-catalog && npm run build && npm run verify:assets && npm run verify:security && npm run verify:automation && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "description": "Aplicación comercial de Shekinah con catálogo, carrito y comercio seguro sobre Cloudflare Pages."
}
